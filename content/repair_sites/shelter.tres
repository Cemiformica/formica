[gd_resource type="Resource" script_class="RepairSiteData" format=3]

[ext_resource type="Script" path="res://core/content/repair_site_data.gd" id="1_site"]
[ext_resource type="Script" path="res://core/content/repair_piece_data.gd" id="2_piece"]
[ext_resource type="PackedScene" path="res://assets/models/props/shelter.glb" id="3_model"]
[ext_resource type="Script" path="res://core/content/item_data.gd" id="4_itemscript"]
[ext_resource type="Resource" path="res://content/items/timber.tres" id="5_timber"]
[ext_resource type="Resource" path="res://content/items/stone_tile.tres" id="6_tile"]
[ext_resource type="Resource" path="res://content/items/wood.tres" id="7_wood"]
[ext_resource type="Resource" path="res://content/items/rope.tres" id="8_rope"]

[sub_resource type="Resource" id="Resource_props"]
script = ExtResource("2_piece")
id = &"props"
name_key = "REPAIR_PIECE_PROPS"
node_name = &"piece_props"
cost = Dictionary[ExtResource("4_itemscript"), int]({
ExtResource("5_timber"): 3
})

[sub_resource type="Resource" id="Resource_floor"]
script = ExtResource("2_piece")
id = &"floor"
name_key = "REPAIR_PIECE_FLOOR"
node_name = &"piece_floor"
cost = Dictionary[ExtResource("4_itemscript"), int]({
ExtResource("6_tile"): 4
})

[sub_resource type="Resource" id="Resource_awning"]
script = ExtResource("2_piece")
id = &"awning"
name_key = "REPAIR_PIECE_AWNING"
node_name = &"piece_awning"
cost = Dictionary[ExtResource("4_itemscript"), int]({
ExtResource("5_timber"): 1,
ExtResource("8_rope"): 1
})

[sub_resource type="Resource" id="Resource_bed"]
script = ExtResource("2_piece")
id = &"bed"
name_key = "REPAIR_PIECE_BED"
node_name = &"piece_bed"
cost = Dictionary[ExtResource("4_itemscript"), int]({
ExtResource("5_timber"): 2,
ExtResource("8_rope"): 1
})
action = &"bed"

[sub_resource type="Resource" id="Resource_hatch"]
script = ExtResource("2_piece")
id = &"hatch"
name_key = "REPAIR_PIECE_HATCH"
node_name = &"piece_hatch"
cost = Dictionary[ExtResource("4_itemscript"), int]({
ExtResource("5_timber"): 1,
ExtResource("8_rope"): 2,
ExtResource("7_wood"): 2
})
action = &"toggle"
aim_node = &"hatch_pull"
aim_size = Vector3(0.6, 0.75, 0.6)
toggle_nodes = Array[StringName]([&"hatch_hinge", &"hatch_lever"])
toggle_rotations = Array[Vector3]([Vector3(-115, 0, 0), Vector3(-70, 0, 0)])

[resource]
script = ExtResource("1_site")
id = &"shelter"
name_key = "REPAIR_SHELTER"
scene = ExtResource("3_model")
size = Vector2i(8, 7)
blocked_cells = Array[Vector2i]([Vector2i(0, 0), Vector2i(1, 0), Vector2i(2, 0), Vector2i(3, 0), Vector2i(4, 0), Vector2i(5, 0), Vector2i(6, 0), Vector2i(7, 0), Vector2i(0, 1), Vector2i(1, 1), Vector2i(6, 1), Vector2i(7, 1), Vector2i(0, 2), Vector2i(1, 2), Vector2i(6, 2), Vector2i(7, 2), Vector2i(0, 3), Vector2i(1, 3), Vector2i(6, 3), Vector2i(7, 3), Vector2i(0, 4), Vector2i(1, 4), Vector2i(6, 4), Vector2i(7, 4), Vector2i(0, 5), Vector2i(1, 5), Vector2i(2, 5), Vector2i(3, 5), Vector2i(4, 5), Vector2i(5, 5), Vector2i(6, 5), Vector2i(7, 5), Vector2i(0, 6), Vector2i(1, 6), Vector2i(6, 6), Vector2i(7, 6)])
exact_collision = true
pieces = Array[ExtResource("2_piece")]([SubResource("Resource_props"), SubResource("Resource_floor"), SubResource("Resource_awning"), SubResource("Resource_bed"), SubResource("Resource_hatch")])
purpose = &"shelter"
