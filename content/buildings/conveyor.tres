[ext_resource type="Resource" path="res://content/items/wood.tres" id="4_wood"]
[ext_resource type="Resource" path="res://content/items/stone.tres" id="5_stone"]

[sub_resource type="Resource" id="Resource_in"]
script = ExtResource("3_portscript")
